---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  fullWidth?: boolean;
  title?: string;
  description?: string;
}

const { fullWidth = false, title, description } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const siteUrl = "https://antoniogarciamengual.com";

const seoByPath: Record<string, { title: string; description: string }> = {
  "/": {
    title: "Antonio García Mengual",
    description:
      "Sitio oficial de Antonio García Mengual: biografía, obras y contacto del escultor murciano.",
  },
  "/biografia": {
    title: "Biografía | Antonio García Mengual",
    description:
      "Biografía de Antonio García Mengual, escultor murciano: trayectoria, estilo y legado artístico.",
  },
  "/obras": {
    title: "Obras | Antonio García Mengual",
    description:
      "Explora la obra de Antonio García Mengual: escultura, imaginería y relieves en diferentes categorías.",
  },
  "/contacto": {
    title: "Contacto | Antonio García Mengual",
    description:
      "Contacto de Antonio García Mengual para información sobre su obra, legado y consultas.",
  },
};

const pathSeo = pathname.startsWith("/obras/")
  ? {
      title: "Detalle de Obra | Antonio García Mengual",
      description:
        "Ficha de obra de Antonio García Mengual con imágenes y detalles de la pieza.",
    }
  : (seoByPath[pathname] ?? seoByPath["/"]);

const pageTitle = title ?? pathSeo.title;
const pageDescription = description ?? pathSeo.description;
const canonicalUrl = new URL(pathname, siteUrl).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Antonio García Mengual" />
    <meta name="application-name" content="Antonio García Mengual" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Antonio García Mengual" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/photoswipe@5.4.4/dist/photoswipe.css"
    />
    <ClientRouter fallback="animate" />
    <script is:inline>
      document.addEventListener("astro:before-swap", (ev) => {
        const fromPath = window.location.pathname;
        const toPath = ev.to.pathname;

        const fromParts = fromPath.split("/").filter(Boolean);
        const toParts = toPath.split("/").filter(Boolean);

        const isGoingToDetail =
          fromParts.length === 2 &&
          toParts.length === 3 &&
          toPath.startsWith(fromPath);

        if (isGoingToDetail) {
          sessionStorage.setItem("scroll-pos-" + fromPath, window.scrollY);
        } else {
          sessionStorage.removeItem("scroll-pos-" + fromPath);
        }

        document.body.classList.remove("pswp-multiple");
        document.body.style.overflow = "";
      });

      document.addEventListener("astro:after-swap", () => {
        const path = window.location.pathname;
        const savedPos = sessionStorage.getItem("scroll-pos-" + path);
        if (savedPos !== null) {
          window.scrollTo(0, parseInt(savedPos));
        }
      });
    </script>
  </head>
  <body>
    <Header transition:persist />
    <main class={fullWidth ? "main-full" : "main-padded"}>
      <slot />
    </main>
    <Footer transition:persist />
  </body>
</html>
