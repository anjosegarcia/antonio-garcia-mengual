---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  fullWidth?: boolean;
  title?: string;
  description?: string;
}

const { fullWidth = false, title, description } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const siteUrl = "https://antoniogarciamengual.com";

const seoByPath: Record<string, { title: string; description: string }> = {
  "/": {
    title: "Antonio García Mengual",
    description:
      "Sitio oficial de Antonio García Mengual: biografía, obras y contacto del escultor murciano.",
  },
  "/biografia": {
    title: "Biografía | Antonio García Mengual",
    description:
      "Biografía de Antonio García Mengual, escultor murciano: trayectoria, estilo y legado artístico.",
  },
  "/obras": {
    title: "Obras | Antonio García Mengual",
    description:
      "Explora la obra de Antonio García Mengual: escultura, imaginería y relieves en diferentes categorías.",
  },
  "/contacto": {
    title: "Contacto | Antonio García Mengual",
    description:
      "Contacto de Antonio García Mengual para información sobre su obra, legado y consultas.",
  },
};

const pathSeo = pathname.startsWith("/obras/")
  ? {
      title: "Detalle de Obra | Antonio García Mengual",
      description:
        "Ficha de obra de Antonio García Mengual con imágenes y detalles de la pieza.",
    }
  : (seoByPath[pathname] ?? seoByPath["/"]);

const pageTitle = title ?? pathSeo.title;
const pageDescription = description ?? pathSeo.description;
const canonicalUrl = new URL(pathname, siteUrl).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Antonio García Mengual" />
    <meta name="application-name" content="Antonio García Mengual" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Antonio García Mengual" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/photoswipe@5.4.4/dist/photoswipe.css"
    />
    <link
      rel="preload"
      href="/fonts/permanent-marker-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ClientRouter fallback="animate" />
    <style is:global>
      ::view-transition-old(root) {
        animation: 90ms cubic-bezier(0.4, 0, 1, 1) both fade-out;
      }
      ::view-transition-new(root) {
        animation: 210ms cubic-bezier(0, 0, 0.2, 1) 90ms both fade-in;
      }

      @keyframes fade-out {
        from {
          opacity: 1;
        }
        to {
          opacity: 0;
        }
      }
      @keyframes fade-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
    </style>
    <script is:inline>
      document.addEventListener("astro:before-swap", (ev) => {
        const fromPath = window.location.pathname;
        const toPath = ev.to.pathname;

        const fromParts = fromPath.split("/").filter(Boolean);
        const toParts = toPath.split("/").filter(Boolean);

        const isGoingToDetail =
          fromParts.length === 2 &&
          toParts.length === 3 &&
          toPath.startsWith(fromPath);

        if (isGoingToDetail) {
          sessionStorage.setItem("scroll-pos-" + fromPath, window.scrollY);
        } else {
          sessionStorage.removeItem("scroll-pos-" + fromPath);
        }

        document.body.classList.remove("pswp-multiple");
        document.body.style.overflow = "";
      });

      document.addEventListener("astro:after-swap", () => {
        const path = window.location.pathname;
        const savedPos = sessionStorage.getItem("scroll-pos-" + path);
        if (savedPos !== null) {
          window.scrollTo(0, parseInt(savedPos));
        }
      });
    </script>
  </head>
  <body>
    <Header transition:persist />
    <main class={fullWidth ? "main-full" : "main-padded"}>
      <slot />
    </main>
    <Footer transition:persist />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Permanent Marker";
    src:
      url("/fonts/permanent-marker-latin-400-normal.woff2") format("woff2"),
      url("/fonts/permanent-marker-latin-400-normal.woff") format("woff");
    font-style: normal;
    font-weight: 400;
    font-display: block;
  }

  html {
    overflow-y: auto;
  }

  body {
    margin: 0;
    width: 100%;
    min-height: 100vh;
    font-family: "Inter", sans-serif;
    display: flex;
    flex-direction: column;
  }

  :focus-visible {
    outline: 2px solid #333;
    outline-offset: 4px;
  }

  main {
    flex: 1;
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .main-padded {
    max-width: 1200px;
    padding: 4rem 2rem;
  }

  .main-full {
    max-width: 100%;
    padding: 0;
  }

  @media (max-width: 768px) {
    .main-padded {
      padding: 2rem 1rem;
    }
  }

  .pswp__img {
    object-fit: contain !important;
    transition: none !important;
    animation: none !important;
  }

  .pswp__img--placeholder {
    display: none !important;
  }

  .pswp-multiple .pswp__button--arrow {
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .pswp-multiple .pswp__button--arrow--prev {
    left: 10px !important;
  }

  .pswp-multiple .pswp__button--arrow--next {
    right: 10px !important;
  }

  .pswp-multiple .pswp__button--arrow::before {
    background-color: rgba(0, 0, 0, 0.4) !important;
    border-radius: 50% !important;
    width: 44px !important;
    height: 44px !important;
  }

  .gallery-btn {
    margin-top: 1.5rem;
    background: transparent;
    border: 1px solid #333;
    padding: 0.6rem 1.2rem;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    cursor: pointer;
    transition: all 0.3s ease;
    color: #333;
    text-transform: uppercase;
    display: inline-block;
  }

  .gallery-btn:hover {
    background: #333;
    color: white;
  }

  .pswp__custom-caption {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.4) 70%,
      transparent 100%
    );
    color: #fff;
    padding: 2rem 1.5rem 1.5rem;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    text-align: center;
    font-weight: 300;
    z-index: 1000;
    pointer-events: none;
  }

  .pswp-caption-content {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .pswp-caption-category {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.7);
    display: block;
    margin-bottom: 0.3rem;
    font-weight: 400;
  }

  .pswp-caption-title {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    display: block;
    margin-bottom: 0.2rem;
  }

  .pswp-caption-year-small {
    font-size: 0.85rem;
    color: #ccc;
    letter-spacing: 0.05em;
    font-weight: 300;
    margin-left: 0.5rem;
  }

  .pswp-caption-meta {
    font-size: 0.75rem;
    color: #bbb;
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    letter-spacing: 0.05em;
  }

  .pswp-caption-meta span:not(:last-child)::after {
    content: "•";
    margin-left: 0.8rem;
    opacity: 0.5;
  }
</style>
