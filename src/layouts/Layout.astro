---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

interface Props {
  fullWidth?: boolean;
  title?: string;
  description?: string;
}

const { fullWidth = false, title, description } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const siteUrl = "https://antoniogarciamengual.com";

const seoByPath: Record<string, { title: string; description: string }> = {
  "/": {
    title: "Antonio García Mengual",
    description:
      "Sitio oficial de Antonio García Mengual: biografía, obras y contacto del escultor murciano.",
  },
  "/biografia": {
    title: "Biografía | Antonio García Mengual",
    description:
      "Biografía de Antonio García Mengual, escultor murciano: trayectoria, estilo y legado artístico.",
  },
  "/obras": {
    title: "Obras | Antonio García Mengual",
    description:
      "Explora la obra de Antonio García Mengual: escultura, imaginería y relieves en diferentes categorías.",
  },
  "/contacto": {
    title: "Contacto | Antonio García Mengual",
    description:
      "Contacto de Antonio García Mengual para información sobre su obra, legado y consultas.",
  },
};

const pathSeo = pathname.startsWith("/obras/")
  ? {
      title: "Detalle de Obra | Antonio García Mengual",
      description:
        "Ficha de obra de Antonio García Mengual con imágenes y detalles de la pieza.",
    }
  : (seoByPath[pathname] ?? seoByPath["/"]);

const pageTitle = title ?? pathSeo.title;
const pageDescription = description ?? pathSeo.description;
const canonicalUrl = new URL(pathname === "/" ? "/" : `${pathname}/`, siteUrl)
  .href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Antonio García Mengual" />
    <meta name="application-name" content="Antonio García Mengual" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Antonio García Mengual" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href="/fonts/permanent-marker-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <Header />
    <main class={fullWidth ? "main-full" : "main-padded"}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Permanent Marker";
    src:
      url("/fonts/permanent-marker-latin-400-normal.woff2") format("woff2"),
      url("/fonts/permanent-marker-latin-400-normal.woff") format("woff");
    font-style: normal;
    font-weight: 400;
    font-display: block;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: "Inter", sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    overflow-y: scroll;
  }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .main-padded {
    max-width: 1200px;
    padding: 4rem 2rem;
  }

  .main-full {
    max-width: 100%;
    padding: 0;
  }

  @media (max-width: 768px) {
    .main-padded {
      padding: 2rem 1rem;
    }
  }
</style>
