---
const pathname = new URL(Astro.request.url).pathname;
const isActive = (path: string) => {
  if (path === "/" && pathname === "/") return true;
  if (path !== "/" && pathname.startsWith(path)) return true;
  return false;
};
---

<header>
  <div class="logo">
    <a href="/">ANTONIO GARCÍA MENGUAL</a>
  </div>
  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-nav"
  >
    <span class="sr-only">Abrir menú</span>
    <span class="bars">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </span>
  </button>
  <div class="nav-overlay"></div>
  <nav>
    <ul id="site-nav">
      <li>
        <a href="/biografia" class={isActive("/biografia") ? "active" : ""}
          >BIOGRAFÍA</a
        >
      </li>
      <li>
        <a href="/obras" class={isActive("/obras") ? "active" : ""}>OBRAS</a>
      </li>
      <li>
        <a href="/contacto" class={isActive("/contacto") ? "active" : ""}
          >CONTACTO</a
        >
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector("header");
  const toggle = document.querySelector(".menu-toggle");
  const nav = document.querySelector("nav");
  const overlay = document.querySelector(".nav-overlay");

  if (header && toggle && nav && overlay) {
    toggle.addEventListener("click", () => {
      const isOpen = header.classList.toggle("menu-open");
      toggle.setAttribute("aria-expanded", String(isOpen));
      overlay.classList.toggle("is-visible", isOpen);
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        if (header.classList.contains("menu-open")) {
          header.classList.remove("menu-open");
          toggle.setAttribute("aria-expanded", "false");
          overlay.classList.remove("is-visible");
        }
      });
    });

    overlay.addEventListener("click", () => {
      if (header.classList.contains("menu-open")) {
        header.classList.remove("menu-open");
        toggle.setAttribute("aria-expanded", "false");
        overlay.classList.remove("is-visible");
      }
    });
  }
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid #eaeaea;
    height: 81px;
    box-sizing: border-box;
    gap: 1rem;
  }

  .logo {
    flex: 1;
    min-width: 0;
  }

  .logo a {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: black;
    text-transform: uppercase;
    display: block;
  }

  .menu-toggle {
    display: none;
    background: transparent;
    border: 0;
    border-radius: 6px;
    padding: 0.55rem 0.65rem;
    cursor: pointer;
    z-index: 3;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .menu-toggle .bar {
    display: block;
    width: 20px;
    height: 2px;
    background: black;
    margin: 5px 0;
    border-radius: 2px;
    transition:
      transform 0.25s ease,
      opacity 0.25s ease,
      width 0.25s ease;
  }

  .menu-toggle:hover {
    background-color: rgba(0, 0, 0, 0.06);
  }

  .menu-toggle:active {
    transform: scale(0.98);
  }

  .menu-toggle:focus-visible {
    outline: 2px solid rgba(0, 0, 0, 0.45);
    outline-offset: 2px;
  }

  header.menu-open .menu-toggle .bars .bar:nth-child(2) {
    opacity: 0;
    width: 0;
  }

  header.menu-open .menu-toggle .bars .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  header.menu-open .menu-toggle .bars .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  nav ul {
    display: flex;
    list-style: none;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
  }

  nav li {
    position: relative;
  }

  nav a {
    text-decoration: none;
    color: #666;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    transition: color 0.3s ease;
    display: block;
    padding: 5px 0;
    position: relative;
  }

  nav a::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 1px;
    background-color: black;
  }

  nav a:hover::after {
    width: 100%;
    transition: width 0.3s ease;
  }

  nav a.active::after {
    width: 100%;
  }

  @media (max-width: 700px) {
    .nav-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.35);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
      z-index: 1;
    }

    .nav-overlay.is-visible {
      opacity: 1;
      pointer-events: auto;
    }

    header {
      padding: 1rem 1rem;
      height: auto;
    }

    .logo a {
      font-size: clamp(0.85rem, 3.6vw, 1.05rem);
      letter-spacing: 0.04em;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    nav ul {
      flex-direction: column;
      gap: 0;
      font-size: 0.9rem;
    }

    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: white;
      border-radius: 0 0 10px 10px;
      border-bottom: 1px solid #eaeaea;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
      padding: 1.25rem 1rem 0.75rem;
      transform: translateY(-10px);
      opacity: 0;
      pointer-events: none;
      transition:
        transform 0.25s ease,
        opacity 0.25s ease;
      z-index: 2;
    }

    nav li {
      padding: 0.25rem 0;
    }

    nav a {
      display: inline-block;
      padding: 0.6rem 0;
    }

    nav a::after,
    nav a:hover::after,
    nav a.active::after {
      width: 0;
      opacity: 0;
    }

    header.menu-open nav {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>
