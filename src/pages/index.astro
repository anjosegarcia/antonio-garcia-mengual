---
import Layout from "@layouts/Layout.astro";
---

<Layout fullWidth={true}>
  <section class="hero">
    <div class="hero-background">
      <img src="/images/banner/agmengual.webp" alt="Antonio García Mengual" />
      <div class="overlay"></div>
    </div>
    <div class="hero-content">
      <h1 id="hero-title">
        <span class="hero-word">Esculpiendo</span>
        <span class="hero-word">el&nbsp;alma</span>
      </h1>
      <p class="subtitle">Vida y obra de un escultor murciano</p>
      <a href="/obras" class="cta">EXPLORAR OBRA</a>
    </div>
  </section>
</Layout>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const title = document.getElementById("hero-title");
    if (!title || title.dataset.animated === "true" || !title.textContent) {
      return;
    }

    title.dataset.animated = "true";
    let letterIndex = 0;
    const wordSpans = Array.from(title.querySelectorAll(".hero-word"));
    if (wordSpans.length === 0) {
      return;
    }

    wordSpans.forEach((wordSpan) => {
      const word = wordSpan.textContent ?? "";
      wordSpan.textContent = "";
      [...word].forEach((char) => {
        const span = document.createElement("span");
        span.textContent = char;
        span.style.opacity = "0";
        span.style.display = "inline-block";
        span.style.animation = `letterFadeIn 0.8s ease forwards ${
          letterIndex * 0.06
        }s`;
        letterIndex += 1;
        wordSpan.appendChild(span);
      });
    });
  });
</script>

<style>
  .hero {
    position: relative;
    height: 100%;
    width: 100%;
    max-width: 100%;

    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #000;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(2px) brightness(0.6);
    opacity: 0.9;
    transform: scale(1.05);
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      circle,
      rgba(0, 0, 0, 0.1) 0%,
      rgba(0, 0, 0, 0.6) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 2rem;
    color: white;
  }

  @keyframes letterFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
      filter: blur(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  h1 {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 300;
    margin-bottom: 1.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    display: inline-block;
    word-break: keep-all;
    overflow-wrap: normal;
    hyphens: none;
  }

  .hero-word {
    display: inline-block;
    white-space: nowrap;
  }

  .subtitle {
    font-size: clamp(1rem, 2vw, 1.5rem);
    color: rgba(255, 255, 255, 0.8);
    font-weight: 300;
    letter-spacing: 0.2em;
    margin-bottom: 3.5rem;
    text-transform: uppercase;
    opacity: 0;
    animation: simpleFadeIn 1.5s ease-out forwards 2s;
  }

  .cta {
    display: inline-block;
    padding: 1.2rem 3rem;
    border: 1px solid white;
    text-decoration: none;
    color: white;
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    transition: all 0.4s ease;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(5px);
    opacity: 0;
    animation: simpleFadeIn 1.5s ease-out forwards 2.5s;
  }

  @keyframes simpleFadeIn {
    to {
      opacity: 1;
    }
  }

  .cta:hover {
    background: white;
    color: black;
  }

  @media (max-width: 768px) {
    .hero {
      height: 100%;
    }
  }

  @media (max-width: 420px) {
    h1 {
      font-size: clamp(2rem, 9vw, 3rem);
      letter-spacing: 0.04em;
    }
  }
</style>
