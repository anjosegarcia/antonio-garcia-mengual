---
export const prerender = false;
import Layout from "@layouts/Layout.astro";
import Icon from "@components/Icons.astro";

let status = { type: "", message: "" };

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const name = data.get("name");
    const email = data.get("email");
    const message = data.get("message");
    const RESEND_API_KEY = import.meta.env.RESEND_API_KEY;
    const response = await fetch("https://api.resend.com/emails", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${RESEND_API_KEY}`,
      },
      body: JSON.stringify({
        from: "Antonio García Mengual <no-reply@antoniogarciamengual.com>",
        to: ["infogarciamengual@gmail.com"],
        reply_to: email,
        subject: `Consulta: ${name} (vía antoniogarciamengual.com)`,
        html: `
          <div lang="es" style="font-family: sans-serif; line-height: 1.6; color: #333; max-width: 600px;">
            <h2 style="font-weight: 300; border-bottom: 1px solid #eee; padding-bottom: 15px;">Nueva consulta recibida</h2>
            <p>Se ha recibido un nuevo mensaje a través del formulario de contacto:</p>
            
            <div style="background: #fdfdfd; border: 1px solid #eee; padding: 20px; border-radius: 8px; margin: 20px 0;">
              <p style="margin: 0 0 10px 0;"><strong>Nombre:</strong> ${name}</p>
              <p style="margin: 0;"><strong>Email:</strong> ${email}</p>
            </div>

            <p><strong>Mensaje:</strong></p>
            <div style="background: #fdfdfd; border: 1px solid #eee; padding: 20px; border-radius: 8px; white-space: pre-wrap; color: #555;">${message}</div>
            
            <p style="font-size: 0.85rem; color: #999; margin-top: 30px; border-top: 1px solid #eee; padding-top: 15px;">
              Este es un mensaje automático enviado desde el formulario de antoniogarciamengual.com
            </p>
          </div>
        `,
      }),
    });

    if (response.ok) {
      status = {
        type: "success",
        message: "Mensaje enviado con éxito. Gracias por contactar.",
      };
    } else {
      const errorData = await response.json();
      console.error("Error de Resend:", errorData);
      status = {
        type: "error",
        message:
          "Hubo un problema al enviar el mensaje. Inténtalo de nuevo o escríbenos a infogarciamengual@gmail.com.",
      };
    }
  } catch (error) {
    console.error("Error al procesar el formulario:", error);
    status = { type: "error", message: "Error interno. Inténtalo más tarde." };
  }
}
---

<Layout>
  <section class="contact-container">
    <header class="page-header">
      <h1 class="page-title">CONTACTO</h1>
      <p class="page-subtitle">
        Para más información sobre la obra y el legado del escultor, o para
        cualquier consulta, puedes utilizar el formulario o escribirnos
        directamente.
      </p>
    </header>

    {
      status.message && (
        <div class={`status-message ${status.type}`}>{status.message}</div>
      )
    }

    <div class="contact-content">
      <section class="contact-form-section">
        <form method="POST" class="contact-form">
          <div class="form-group">
            <label for="name">Nombre completo</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Tu nombre..."
            />
          </div>

          <div class="form-group">
            <label for="email">Correo electrónico</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="tu@email.com"
            />
          </div>

          <div class="form-group">
            <label for="message">Mensaje</label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="¿En qué podemos ayudarte?"></textarea>
          </div>

          <button type="submit" class="gallery-btn">
            <span>ENVIAR MENSAJE</span>
            <Icon name="send" size={16} />
          </button>
        </form>
      </section>

      <section class="contact-sidebar">
        <div class="divider"></div>
        <div class="contact-item">
          <span class="label">O Escríbenos directamente</span>
          <div class="contact-actions">
            <a
              href="mailto:infogarciamengual@gmail.com"
              class="contact-link"
              data-astro-reload
            >
              infogarciamengual@gmail.com
            </a>
            <button
              type="button"
              class="gallery-btn copy-button"
              data-copy-email
            >
              <span class="copy-icon-wrapper" data-copy-icon>
                <Icon name="copy" size={16} class="icon-copy" />
                <Icon name="check" size={16} class="icon-check" />
              </span>
              <span class="copy-label">Copiar</span>
            </button>
          </div>
        </div>
        <div class="divider"></div>
      </section>
    </div>
  </section>
</Layout>

<script>
  const initContact = () => {
    const copyButton = document.querySelector(
      "[data-copy-email]",
    ) as HTMLButtonElement;
    const label = copyButton?.querySelector(".copy-label");

    if (copyButton && label) {
      copyButton.addEventListener("click", async () => {
        if (copyButton.hasAttribute("disabled")) return;
        const email = "infogarciamengual@gmail.com";
        try {
          await navigator.clipboard.writeText(email);
          copyButton.classList.add("is-copied");
          copyButton.setAttribute("disabled", "true");
          label.textContent = "Copiado";

          setTimeout(() => {
            copyButton.classList.remove("is-copied");
            copyButton.removeAttribute("disabled");
            label.textContent = "Copiar";
          }, 1600);
        } catch {}
      });
    }

    const form = document.querySelector(".contact-form") as HTMLFormElement;
    if (form) {
      form.addEventListener("submit", () => {
        const btn = form.querySelector(".gallery-btn") as HTMLButtonElement;
        const span = btn?.querySelector("span");
        if (span) span.textContent = "ENVIANDO...";
        if (btn) {
          btn.style.opacity = "0.7";
          btn.style.pointerEvents = "none";
        }
      });
    }
  };

  document.addEventListener("astro:page-load", initContact);
</script>

<style>
  .contact-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem 6rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .page-title {
    font-size: 2.4rem;
    font-weight: 300;
    letter-spacing: 0.05em;
    margin: 0;
    text-transform: uppercase;
  }

  .page-subtitle {
    font-size: 1rem;
    color: #666;
    line-height: 1.5;
    font-weight: 300;
    max-width: 600px;
    margin: 1.5rem auto 0;
    text-align: justify;
    hyphens: auto;
  }

  .contact-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8rem;
    align-items: start;
    position: relative;
  }

  .contact-content::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: #eee;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .form-group label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #999;
  }

  .form-group input,
  .form-group textarea {
    padding: 1rem 0;
    border: none;
    border-bottom: 1px solid #eee;
    font-family: inherit;
    font-size: 0.95rem;
    background: transparent;
    transition: all 0.3s ease;
    border-radius: 0;
    outline: none;
    font-weight: 300;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-bottom-color: #111;
  }

  .gallery-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 1.5rem;
    width: fit-content;
    vertical-align: middle;
  }

  .gallery-btn span {
    line-height: 1;
  }

  .copy-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    position: relative;
  }

  .icon-check {
    display: none;
  }

  .copy-button.is-copied .icon-copy {
    display: none;
  }

  .copy-button.is-copied .icon-check {
    display: block;
  }

  .contact-sidebar {
    padding: 0;
    background: transparent;
    border: none;
  }

  .contact-item {
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #999;
  }

  .contact-link {
    font-size: 1.2rem;
    color: #111;
    text-decoration: none;
    font-weight: 300;
    transition: all 0.3s ease;
    border-bottom: 1px solid transparent;
    padding-bottom: 0.2rem;
  }

  .contact-link:hover {
    border-bottom-color: #111;
  }

  @media (max-width: 900px) {
    .contact-content {
      grid-template-columns: 1fr;
      gap: 5rem;
    }

    .contact-content::after {
      display: none;
    }

    .contact-form-section {
      order: 1;
    }

    .contact-sidebar {
      order: 2;
      border-top: 1px solid #eee;
      padding-top: 4rem;
    }

    .contact-item {
      align-items: center;
      text-align: center;
    }

    .contact-actions {
      align-items: center;
    }

    .gallery-btn {
      width: 100%;
    }
  }

  .status-message {
    padding: 0.8rem 2rem;
    margin: 0 auto 3.5rem;
    font-size: 0.9rem;
    line-height: 1.2;
    letter-spacing: 0.01em;
    font-weight: 300;
    text-align: center;
    border-radius: 2px;
    width: fit-content;
    max-width: 100%;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .status-message {
      white-space: normal;
      width: 100%;
    }
  }

  .status-message.success {
    background-color: #f4fcf4;
    color: #1b5e20;
    border-left: 4px solid #4caf50;
  }

  .status-message.error {
    background-color: #fff5f5;
    color: #c62828;
    border-left: 4px solid #f44336;
  }
</style>
