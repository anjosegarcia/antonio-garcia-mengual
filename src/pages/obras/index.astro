---
import Layout from "@layouts/Layout.astro";
import { categories, works } from "@data/portfolio";
import GalleryLightbox from "@components/GalleryLightbox.astro";
import { Image } from "astro:assets";
import Icon from "@components/Icons.astro";

type Category = (typeof categories)[number];
const categoryItems: Category[] = categories;
---

<Layout>
  <section class="categories-container">
    <header class="page-header">
      <h1 class="page-title">OBRAS</h1>
      <GalleryLightbox items={works} />
    </header>

    <div class="categories-grid">
      {
        categoryItems.map((cat) => (
          <a href={`/obras/${cat.id}`} class="category-card">
            <div class="category-image">
              {cat.image ? (
                <Image
                  src={cat.image}
                  alt={`Colección de ${cat.title}`}
                  width={600}
                  height={450}
                />
              ) : (
                <div class="image-fallback" aria-hidden="true" />
              )}
              <div class="placeholder-overlay" />
            </div>
            <div class="card-content">
              <h2>{cat.title}</h2>
              <span class="explore">
                VER COLECCIÓN{" "}
                <Icon name="arrow-right" size={14} class="arrow" />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .categories-container {
    padding-top: 0;
    padding-bottom: 2rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 4rem;
    margin-top: 0;
  }

  .page-title {
    font-size: 2.4rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .category-card {
    height: 450px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: white;
    position: relative;
    overflow: hidden;
    background-color: #1a1a1a;
  }

  .category-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .category-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    transition: transform 0.6s ease;
  }

  .category-card:hover .category-image img {
    transform: scale(1.05);
  }

  .placeholder-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    background: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.6));
    transition: background 0.4s ease;
  }

  .card-content {
    position: relative;
    text-align: center;
    z-index: 10;
    padding: 2rem;
    pointer-events: none;
  }

  h2 {
    font-size: 1.8rem;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin: 0 0 1rem 0;
    transition: transform 0.4s ease;
  }

  .explore {
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    opacity: 0.8;
    border-bottom: 1px solid white;
    padding-bottom: 5px;
    transition: all 0.4s ease;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }

  .arrow {
    transition: transform 0.4s ease;
  }

  .category-card:hover .explore {
    opacity: 1;
    letter-spacing: 0.4em;
  }

  .category-card:hover .arrow {
    transform: translateX(5px);
  }

  .image-fallback {
    width: 100%;
    height: 100%;
    background-color: #111;
  }

  @media (max-width: 768px) {
    .categories-grid {
      grid-template-columns: 1fr;
    }
    .category-card {
      height: 350px;
    }
  }
</style>
